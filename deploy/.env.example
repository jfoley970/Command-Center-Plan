# The app's name under your domain. Public DNS points it at the address on your
# public IP block that NATs to this server.
CC_PUBLIC_HOST=cc.example.com
# Authentik's sign-in pages, same public address.
CC_AUTH_HOST=auth.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@example.com
# This server's LAN address, the target of the 80/443 NAT from the public IP block.
PUBLIC_ADDRESS=192.168.10.20
# The server's address on the WireGuard network (admin path).
WG_ADDRESS=10.66.0.1
# Who may open Authentik's admin UI: the WireGuard subnet only. Don't add the
# LAN if your edge masquerades forwarded traffic, or every internet visitor
# would look like they came from the router.
ADMIN_RANGES=10.66.0.0/24
# Authentik, as Caddy reaches it. Bind Authentik to this address, not to the
# public one, so Caddy is its only way in.
AUTH_OUTPOST=http://10.66.0.1:9000
TZ=America/Denver

# Local AI (Ollama). "llm" starts it next to the server; leave empty to skip it.
COMPOSE_PROFILES=llm
# Add docker-compose.gpu.yml once the GPU, its driver and the NVIDIA container
# toolkit are in. Without it Ollama runs on the CPU (fine for 3-4B models).
COMPOSE_FILE=docker-compose.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
