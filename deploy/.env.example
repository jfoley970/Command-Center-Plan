# The name the app will live at, under your domain. Pick it later; any name
# that resolves to WG_ADDRESS over the tunnel works.
CC_PUBLIC_HOST=cc.example.com
# The server's address on the WireGuard network. Caddy listens only here.
WG_ADDRESS=10.66.0.1
# The auth service's outpost, as Caddy should reach it (Authentik embedded outpost shown).
AUTH_OUTPOST=http://10.66.0.1:9000
TZ=America/Denver
